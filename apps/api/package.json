{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "pretypecheck": "prisma generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "start:dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch-path=dist dist/main.js",
    "start:worker": "node dist/worker.js",
    "prisma:generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "seed": "node dist/seed/seed.js",
    "seed:dev": "tsc -p tsconfig.build.json && node dist/seed/seed.js",
    "import:del": "node dist/import/import-del.js",
    "pretest": "prisma generate",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand",
    "test:unit": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --testPathPatterns=src",
    "test:e2e": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand --testPathPatterns=test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@aws-sdk/client-s3": "3.1176.0",
    "@aws-sdk/client-sesv2": "3.1176.0",
    "@aws-sdk/s3-request-presigner": "3.1176.0",
    "@mux/mux-node": "15.5.0",
    "@nestjs/bullmq": "12.0.2",
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "@nestjs/throttler": "6.8.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@resvg/resvg-js": "^2.6.2",
    "argon2": "0.45.2",
    "bullmq": "6.7.10",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nodemailer": "10.6.1",
    "opentype.js": "^1.3.4",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "stripe": "23.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.6.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/opentype.js": "^1.3.10",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "jsqr": "^1.4.0",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  }
}
