// AI Learning Marketplace data model. See docs/BUILD_SPEC.md.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  student
  instructor
  admin
  super_admin
}

enum UserStatus {
  active
  suspended
}

enum InstructorStatus {
  pending
  approved
  rejected
  /// A super admin or admin has started reviewing the application.
  under_review
  /// The reviewer asked the applicant for more information (they can update and resubmit).
  needs_info
}

enum CourseLevel {
  beginner
  intermediate
  advanced
}

enum CourseStatus {
  draft
  in_review
  changes_requested
  published
  unpublished
  rejected
}

enum LectureType {
  video
  article
  quiz
}

enum VideoProvider {
  local
  mux
}

enum VideoStatus {
  uploading
  processing
  ready
  failed
}

enum OrderStatus {
  pending
  paid
  failed
  refunded
  partially_refunded
}

enum TransferStatus {
  none
  pending
  paid
  reversed
}

/// Who receives the instructor share of a line: the instructor (Stripe transfer), or DEL (its own course, or an
/// instructor with a written "pay to DEL" agreement). DEL lines never create a transfer.
enum Payee {
  instructor
  platform
  del_agreement
}

enum DisputeStatus {
  open
  won
  lost
}

enum RefundRequestStatus {
  pending
  approved
  declined
  /// Automatically decided by the policy (eligible → refunded at once; not eligible → declined with an email).
  auto_approved
  auto_declined
}

enum EnrollmentSource {
  purchase
  free
  admin
  /// Manual enrollment (external payment or complimentary), approved by a super admin.
  manual
}

enum ReviewStatus {
  visible
  hidden
}

/// Pending edits to a PUBLISHED course (the live course is untouched until an admin approves).
enum RevisionStatus {
  draft
  in_review
  changes_requested
  approved
  rejected
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  /// Null for accounts that only use Google, GitHub, Facebook or LinkedIn (no marketplace password).
  passwordHash String?
  name         String
  avatarUrl    String?
  roles        Role[]     @default([student])
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now())

  sessions           Session[]
  instructorProfile  InstructorProfile?
  courses            Course[]           @relation("CourseInstructor")
  videoAssets        VideoAsset[]
  cartItems          CartItem[]
  orders             Order[]
  orderLinesAsSeller OrderLine[]        @relation("LineInstructor")
  ledgerEntries      LedgerEntry[]
  refundRequests     RefundRequest[]
  enrollments        Enrollment[]
  progress           LectureProgress[]
  reviews            Review[]
  certificates       Certificate[]
  pathFollows        CareerPathFollow[]
  quizAttempts       QuizAttempt[]
  auditLogs          AuditLog[]

  @@map("users")
  supportTickets    SupportTicket[]  @relation("TicketRequester")
  assignedTickets   SupportTicket[]  @relation("TicketAssignee")
  supportMessages   SupportMessage[] @relation("TicketMessageAuthor")
  playbackSessions  PlaybackSession[]
  /// Two-step sign-in (Google Authenticator, RFC 6238). The seed is sealed with a key derived from SESSION_SECRET.
  mfaSecret         String?
  mfaEnabledAt      DateTime?
  /// The last accepted 30-second step: a code is never accepted twice.
  mfaLastStep       Int?
  /// Lockout after repeated failed passwords or codes.
  failedLogins      Int       @default(0)
  lockedUntil       DateTime?
  passwordChangedAt DateTime?
  identities        AuthIdentity[]
  recoveryCodes     MfaRecoveryCode[]
  authTickets       AuthTicket[]
  trustedDevices    TrustedDevice[]
  passwordResets    PasswordReset[]
  /// Admin role only: the operational permissions a super admin granted (src/common/permissions.ts). Super admins have all.
  adminPermissions  String[]  @default([])
  /// How the account was created: email | google | github | facebook | linkedin | invitation | seed.
  signupMethod      String    @default("email")
  /// When the person proved they own the email address (link or code, or a provider that verified it).
  emailVerifiedAt   DateTime?
  emailVerifications EmailVerification[]
}

/// Email ownership: a single-use link (or six-digit code for invitations), stored hashed.
model EmailVerification {
  id        String    @id // sha256 of the token or "code:<userId>:<code>"
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("email_verifications")
}

model Session {
  id        String    @id // sha256 of the cookie value; the raw token is never stored
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  ip        String?
  userAgent String?
  revokedAt DateTime?

  @@index([userId])
  @@map("sessions")
}

model InstructorProfile {
  userId          String           @id
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline        String           @default("")
  bio             String           @default("")
  website         String?
  status          InstructorStatus @default(pending)
  reviewNote      String?
  isPlatform      Boolean          @default(false) // the platform's own brand (DEL): no transfers
  stripeAccountId String?          @unique
  payoutsEnabled  Boolean          @default(false)
  /// Super-admin override of the platform's share (basis points of the net). null = the platform default.
  commissionBps   Int?
  /// Written agreement: this instructor's share is kept by DEL (no Stripe transfer). Set by a super admin, audited.
  payToPlatform   Boolean          @default(false)
  termsNote       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  /// Instructor application (owner 2026-11-25): what the applicant told DEL.
  expertise       String[]         @default([])
  experience      String           @default("")
  plannedCourses  String           @default("")
  extraInfo       String           @default("")
  submittedAt     DateTime?
  reviewedById    String?
  reviewedAt      DateTime?

  @@map("instructor_profiles")
}

model Category {
  id      String   @id @default(uuid())
  slug    String   @unique
  name    String
  icon    String   @default("")
  sort    Int      @default(0)
  courses Course[]

  @@map("categories")
}

model Course {
  id                String       @id @default(uuid())
  slug              String       @unique
  instructorId      String
  instructor        User         @relation("CourseInstructor", fields: [instructorId], references: [id])
  categoryId        String?
  category          Category?    @relation(fields: [categoryId], references: [id])
  title             String
  subtitle          String       @default("")
  description       String       @default("")
  language          String       @default("en")
  level             CourseLevel  @default(beginner)
  objectives        String[]     @default([])
  requirements      String[]     @default([])
  priceCents        Int          @default(0)
  currency          String       @default("usd")
  thumbnailKey      String?
  promoVideoAssetId String?
  status            CourseStatus @default(draft)
  reviewNote        String?
  publishedAt       DateTime?
  ratingAvg         Float        @default(0)
  ratingCount       Int          @default(0)
  studentCount      Int          @default(0)
  /// When the content was last checked against the current tools/services (imported catalogue: the video file date).
  lastVerifiedAt    DateTime?
  /// The instructor left this course out of marketplace-wide promotions (DEL's own courses are always included).
  promoOptOut       Boolean      @default(false)
  /// Standard cover (owner 2026-11-25): every course uses a platform template; the image is generated on the server.
  coverTemplateId   String?
  coverTemplate     CoverTemplate? @relation(fields: [coverTemplateId], references: [id])
  /// Storage key of the generated cover (images/covers/<courseId>-<hash>.png); the hash changes with title, topic or template.
  coverKey          String?
  coverHash         String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  sections     Section[]
  packageFiles CourseResource[]
  revisions    CourseRevision[]
  cartItems    CartItem[]
  orderLines   OrderLine[]
  enrollments  Enrollment[]
  reviews      Review[]
  certificates Certificate[]
  sales        CourseSale[]
  pathSteps    CareerPathStep[]

  @@index([status, publishedAt])
  @@index([instructorId])
  @@map("courses")
}

/// Snapshot of the editable course tree (details, media, price, sections, lectures, resources, quizzes) for a
/// published course. At most one open revision (draft | in_review | changes_requested) per course (service layer).
model CourseRevision {
  id          String         @id @default(uuid())
  courseId    String
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status      RevisionStatus @default(draft)
  snapshot    Json
  reviewNote  String?
  submittedAt DateTime?
  decidedAt   DateTime?
  decidedById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([courseId, status])
  @@index([status, submittedAt])
  @@map("course_revisions")
}

model Section {
  id       String    @id @default(uuid())
  courseId String
  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  position Int
  lectures Lecture[]

  @@index([courseId, position])
  @@map("sections")
}

model Lecture {
  id           String      @id @default(uuid())
  sectionId    String
  section      Section     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title        String
  position     Int
  type         LectureType @default(video)
  videoAssetId String?
  videoAsset   VideoAsset? @relation(fields: [videoAssetId], references: [id], onDelete: SetNull)
  articleMd    String?
  /// One line shown in the curriculum ("what this lesson covers").
  summary      String      @default("")
  durationSec  Int         @default(0)
  isPreview    Boolean     @default(false)

  resources Resource[]
  quiz      Quiz?
  progress  LectureProgress[]

  @@index([sectionId, position])
  @@map("lectures")
}

model VideoAsset {
  id            String        @id @default(uuid())
  ownerId       String
  owner         User          @relation(fields: [ownerId], references: [id])
  provider      VideoProvider @default(local)
  status        VideoStatus   @default(uploading)
  storageKey    String?
  muxUploadId   String?       @unique
  muxAssetId    String?       @unique
  muxPlaybackId String?
  durationSec   Int           @default(0)
  captionsKey   String?
  error         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lectures      Lecture[]

  @@index([ownerId])
  @@map("video_assets")
  /// Encrypted HLS rendition (content protection): none | queued | processing | ready | failed | unsupported.
  hlsStatus     String    @default("none")
  /// Random storage prefix of the segments (hls/<prefix>/seg_00000.ts): unguessable, new for every packaging run.
  hlsPrefix     String?
  /// The playlist with placeholders for the key URI and segment URLs (filled per playback session).
  hlsPlaylist   String?
  /// The 16-byte AES-128 key, wrapped with a key derived from SESSION_SECRET (never stored in the clear).
  hlsKey        String?
  hlsIv         String?
  hlsError      String?
  hlsAttempts   Int       @default(0)
  hlsPackagedAt DateTime?
  /// Qualities for adaptive playback: [{ name, height, width, bandwidth, playlist }] (source first). Null = single quality (packaged before 2026-11-26).
  hlsVariants   Json?
  playbackSessions PlaybackSession[]
  helpVideo     HelpVideo?
  captionIndex    CaptionIndex?
  captionSegments CaptionSegment[]
  studyNotes      StudyNotes?
}

/// AI learning (docs/AI_LEARNING.md): which caption file of a video is in the search index (ETag + content hash detect changes).
model CaptionIndex {
  videoAssetId String     @id
  videoAsset   VideoAsset @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)
  captionsKey  String
  etag         String?
  /// sha256 of the caption file: notes are regenerated when it changes.
  contentHash  String
  segmentCount Int        @default(0)
  /// ready | empty | failed
  status       String     @default("ready")
  error        String?
  indexedAt    DateTime   @default(now())

  @@map("caption_indexes")
}

/// Spoken content of a video, a few caption cues merged into one passage (about 15 s), searchable to the moment.
/// `tsv` is a stored generated column (to_tsvector('english', text)) with a GIN index, created in the migration.
model CaptionSegment {
  id           String                   @id @default(uuid())
  videoAssetId String
  videoAsset   VideoAsset               @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)
  seq          Int
  startSec     Float
  endSec       Float
  text         String
  tsv          Unsupported("tsvector")?

  @@unique([videoAssetId, seq])
  @@index([tsv], type: Gin)
  @@map("caption_segments")
}

/// AI study notes of one lesson video, generated once per caption version (contentHash) and shared by every learner.
model StudyNotes {
  videoAssetId String     @id
  videoAsset   VideoAsset @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)
  contentHash  String
  /// queued | generating | ready | failed | empty
  status       String     @default("queued")
  summary      String     @default("")
  /// string[]
  keyPoints    Json       @default("[]")
  /// { question, answer }[]
  questions    Json       @default("[]")
  model        String?
  error        String?
  attempts     Int        @default(0)
  generatedAt  DateTime?
  updatedAt    DateTime   @updatedAt

  @@map("study_notes")
}

/// One AI request (ask | notes): counts for rate limits, cost and audit. Never stores the question, answer or transcript.
model AiUsage {
  id               String   @id @default(uuid())
  userId           String?
  kind             String
  courseId         String?
  lectureId        String?
  model            String?
  /// pending | ok | not_covered | refused | limited | error
  status           String   @default("pending")
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  passages         Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([userId, kind, createdAt])
  @@index([kind, createdAt])
  @@map("ai_usage")
}

model Resource {
  id         String   @id @default(uuid())
  lectureId  String
  lecture    Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  title      String
  storageKey String
  sizeBytes  Int
  mime       String
  createdAt  DateTime @default(now())

  @@map("resources")
}

model Quiz {
  id        String        @id @default(uuid())
  lectureId String        @unique
  lecture   Lecture       @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  questions Json // [{ q, options[3..5], correct, why }]
  attempts  QuizAttempt[]

  @@map("quizzes")
}

model QuizAttempt {
  id      String   @id @default(uuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId  String
  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score   Int // percent 0..100
  answers Json
  at      DateTime @default(now())

  @@index([userId, quizId])
  @@map("quiz_attempts")
}

model CartItem {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, courseId])
  @@map("cart_items")
}

model Order {
  id                       String          @id @default(uuid())
  userId                   String
  user                     User            @relation(fields: [userId], references: [id])
  status                   OrderStatus     @default(pending)
  totalCents               Int
  currency                 String          @default("usd")
  provider                 String          @default("stripe") // stripe | test | free
  stripeCheckoutSessionId  String?         @unique
  stripePaymentIntentId    String?         @unique
  stripeChargeId           String?
  paidAt                   DateTime?
  /// Stripe processing fee for the whole order (null until Stripe reports it; simulated for dev test payments).
  stripeFeeCents           Int?
  feeSource                String? // stripe | simulated | none
  balanceTxnId             String?
  taxCents                 Int             @default(0)
  refundEligibleUntil      DateTime?
  /// Buyer asked for immediate access and acknowledged the withdrawal-right rule (EU/UK digital content).
  immediateAccessConsentAt DateTime?
  /// Terms of use + Access and refunds policy accepted at checkout: version (src/commerce/terms.ts), time and IP.
  termsVersion             String?
  termsAcceptedAt          DateTime?
  termsAcceptedIp          String?
  disputes                Dispute[]
  refundRequests           RefundRequest[]
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  lines                    OrderLine[]

  @@index([userId, createdAt])
  @@map("orders")
}

model OrderLine {
  id                   String         @id @default(uuid())
  orderId              String
  order                Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courseId             String
  course               Course         @relation(fields: [courseId], references: [id])
  instructorId         String
  instructor           User           @relation("LineInstructor", fields: [instructorId], references: [id])
  /// What the learner paid for this course (the sale price when a sale applied). The split is calculated on it.
  priceCents           Int
  /// The course's regular price at purchase; equals priceCents when no sale applied.
  listPriceCents       Int?
  /// The sale that set priceCents: "course_sale" (instructor) or "promotion" (marketplace-wide), with its id.
  saleKind             String?
  saleId               String?
  /// Platform share of the net in basis points, snapshotted at purchase (10000 = DEL's own course).
  commissionBps        Int
  feeCents             Int            @default(0)
  netCents             Int            @default(0)
  instructorShareCents Int
  payee                Payee          @default(instructor)
  transferId           String?
  transferStatus       TransferStatus @default(none)
  transferDueAt        DateTime?
  /// open while a chargeback is in progress: the line's payout is frozen.
  disputeStatus        DisputeStatus?
  refundedAt           DateTime?
  enrollment           Enrollment?
  ledgerEntries        LedgerEntry[]

  @@index([orderId])
  @@index([instructorId])
  @@map("order_lines")
}

model Enrollment {
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  orderLineId String?          @unique
  orderLine   OrderLine?       @relation(fields: [orderLineId], references: [id])
  source      EnrollmentSource
  createdAt   DateTime         @default(now())
  revokedAt   DateTime?

  @@id([userId, courseId])
  @@index([courseId])
  @@index([accessExpiresAt])
  @@map("enrollments")
  /// One-year access (owner 2026-11-25): null = no expiry (free courses, admin grants, the course's own instructor).
  accessExpiresAt DateTime?
  /// Expiry reminders already sent ('30d', '7d', '1d', 'expired').
  remindersSent   String[]  @default([])
}

model LectureProgress {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lectureId   String
  lecture     Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  positionSec Int      @default(0)
  completed   Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@id([userId, lectureId])
  @@map("lecture_progress")
  /// Unique seconds actually played, as merged [start, end] ranges: replays and skips don't add (refund rule, docs/ACCESS_AND_REFUNDS.md).
  watchedRanges Json     @default("[]")
  watchedSec    Int      @default(0)
}

model Review {
  id              String       @id @default(uuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  rating          Int
  body            String       @default("")
  status          ReviewStatus @default(visible)
  instructorReply String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([userId, courseId])
  @@index([courseId, status])
  @@map("reviews")
}

model Certificate {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  code     String   @unique
  issuedAt DateTime @default(now())

  @@unique([userId, courseId])
  @@map("certificates")
}

model PlatformSetting {
  key   String @id
  value Json

  @@map("platform_settings")
}

model WebhookEvent {
  id          String   @id // provider event id (stripe evt_..., mux:<id>)
  type        String
  processedAt DateTime @default(now())

  @@map("webhook_events")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  ip         String?
  meta       Json     @default("{}")
  at         DateTime @default(now())

  @@index([at])
  @@index([actorId])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

/// Money an instructor owes back (refund or lost dispute after their share was transferred) and how it was recovered.
/// amountCents < 0: owed by the instructor; > 0: recovered (netted from a later transfer, or reversed in Stripe).
model LedgerEntry {
  id           String     @id @default(uuid())
  instructorId String
  instructor   User       @relation(fields: [instructorId], references: [id])
  orderLineId  String?
  orderLine    OrderLine? @relation(fields: [orderLineId], references: [id])
  amountCents  Int
  kind         String // refund_clawback | dispute_clawback | netted | reversal
  note         String?
  createdAt    DateTime   @default(now())

  @@index([instructorId, createdAt])
  @@map("ledger_entries")
}

model Dispute {
  id          String        @id // Stripe dispute id (dp_...)
  orderId     String?
  order       Order?        @relation(fields: [orderId], references: [id])
  amountCents Int
  currency    String        @default("usd")
  reason      String?
  status      DisputeStatus @default(open)
  createdAt   DateTime      @default(now())
  closedAt    DateTime?

  @@index([status])
  @@map("disputes")
}

/// A learner's refund request that needs an admin (over the yearly self-service limit, or outside the policy).
model RefundRequest {
  id           String              @id @default(uuid())
  orderId      String
  order        Order               @relation(fields: [orderId], references: [id])
  userId       String
  user         User                @relation(fields: [userId], references: [id])
  lineIds      String[]
  reason       String?
  status       RefundRequestStatus @default(pending)
  decisionNote String?
  decidedById  String?
  createdAt    DateTime            @default(now())
  decidedAt    DateTime?

  @@index([status, createdAt])
  @@map("refund_requests")
  /// Facts at the time of the request, from backend records only: purchase and request dates, course duration,
  /// unique seconds watched, percent, threshold, window, eligibility and reasons per line.
  analysis       Json?
  /// Optional AI summary of the facts (Claude); never changes the decision.
  aiSummary      String?
  aiModel        String?
  /// The student asked for a human review of an automatic decline (exceptions, wrong playback data, legal rights).
  reviewRequestedAt DateTime?
  reviewNote     String?
  processedAt    DateTime?
}

/// An instructor's own sale on one course: a fixed sale price between startsAt and endsAt (UTC). Never stored on the
/// course itself, so the regular price returns by itself when the sale ends. At most one non-cancelled sale per course
/// overlaps any moment (service layer).
model CourseSale {
  id             String    @id @default(uuid())
  courseId       String
  course         Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  salePriceCents Int
  startsAt       DateTime
  endsAt         DateTime
  canceledAt     DateTime?
  canceledById   String?
  cancelNote     String?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([courseId, endsAt])
  @@index([startsAt, endsAt])
  @@map("course_sales")
}

enum PromotionScope {
  all
  categories
  courses
}

/// A marketplace-wide promotion run by a super admin: percentOff on every paid course in scope between startsAt and
/// endsAt (UTC). Courses whose instructor opted out are skipped (DEL's own courses never are). Lowest price wins
/// against an instructor sale; discounts never stack.
model Promotion {
  id           String         @id @default(uuid())
  name         String
  percentOff   Int
  startsAt     DateTime
  endsAt       DateTime
  scope        PromotionScope @default(all)
  categoryIds  String[]       @default([])
  courseIds    String[]       @default([])
  canceledAt   DateTime?
  createdById  String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([startsAt, endsAt])
  @@map("promotions")
}

/// A course cover template: one layout, palette and design drawn by the cover renderer (apps/api/src/covers). The built-in
/// collection is inserted on start-up; a super admin can edit, reorder, deactivate or add templates.
model CoverTemplate {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  layout    String
  motif     String
  /// { bg: [from, to], ink, a, b, tone: dark|light }
  palette   Json
  topics    String[] @default([])
  group     String   @default("generic")
  active    Boolean  @default(true)
  sort      Int      @default(0)
  builtIn   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  courses   Course[]

  @@index([active, sort])
  @@map("cover_templates")
}

enum TicketStatus {
  new
  open
  waiting_user
  resolved
  closed
}

enum TicketPriority {
  low
  normal
  high
  urgent
}

/// Support Center (owner 2026-11-25, adapted from the Insurance Knowledge Hub). Shown as SUP-000123 (number, padded).
/// Status moves happen on the server only; requesters reply, confirm or reopen.
model SupportTicket {
  id              String         @id @default(uuid())
  number          Int            @unique @default(autoincrement())
  requesterId     String
  requester       User           @relation("TicketRequester", fields: [requesterId], references: [id])
  subject         String
  category        String
  priority        TicketPriority @default(normal)
  status          TicketStatus   @default(new)
  courseId        String?
  orderId         String?
  /// Browser, OS, device, page, installed app: supplied by the browser when the ticket is opened.
  context         Json?
  assignedToId    String?
  assignedTo      User?          @relation("TicketAssignee", fields: [assignedToId], references: [id])
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  messages        SupportMessage[]

  @@index([requesterId, updatedAt])
  @@index([status, updatedAt])
  @@map("support_tickets")
}

/// One message in a ticket: plain text (never HTML). `internal` notes are visible to staff only.
model SupportMessage {
  id          String              @id @default(uuid())
  ticketId    String
  ticket      SupportTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId    String
  author      User                @relation("TicketMessageAuthor", fields: [authorId], references: [id])
  staff       Boolean             @default(false)
  internal    Boolean             @default(false)
  /// system messages record status changes ("Marked as resolved").
  kind        String              @default("message")
  body        String
  createdAt   DateTime            @default(now())
  attachments SupportAttachment[]

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

/// A private file on a message (screenshots, PDFs): stored under support/<uploaderId>/, served only to people who may read the ticket.
model SupportAttachment {
  id         String         @id @default(uuid())
  messageId  String
  message    SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  storageKey String         @unique
  name       String
  mime       String
  sizeBytes  Int
  createdAt  DateTime       @default(now())

  @@map("support_attachments")
}

/// One viewing of a protected video: binds the manifest and the key to one person, one video and a time window.
/// `ref` is the short code shown in the moving watermark; a super admin can trace it to the account.
model PlaybackSession {
  id        String     @id @default(uuid())
  ref       String     @unique
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId   String
  asset     VideoAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  lectureId String?
  ip        String?
  userAgent String?
  createdAt DateTime   @default(now())
  expiresAt DateTime

  @@index([userId, createdAt])
  @@map("playback_sessions")
}

/// Help videos ("how to use DEL"), produced by video-academy/ and managed in Admin > Help videos (owner 2026-11-25).
model HelpVideo {
  id           String      @id @default(uuid())
  slug         String      @unique
  title        String
  summary      String
  /// students | instructors | everyone
  audience     String      @default("everyone")
  category     String
  sort         Int         @default(0)
  videoAssetId String?     @unique
  videoAsset   VideoAsset? @relation(fields: [videoAssetId], references: [id], onDelete: SetNull)
  /// Public image key (images/<owner>/<file>), the cover drawn by the video engine.
  coverKey     String?
  /// [{ "t": seconds, "title": "..." }]
  chapters     Json?
  published    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([published, category, sort])
  @@map("help_videos")
}

/// A Google, GitHub, Facebook or LinkedIn account linked to a user (owner 2026-11-25). Never merged by email alone.
model AuthIdentity {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// google | github | facebook | linkedin | test (development only)
  provider   String
  /// The provider's stable account id (OIDC `sub`, GitHub/Facebook numeric id).
  subject    String
  email      String?
  name       String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@unique([provider, subject])
  @@index([userId])
  @@map("auth_identities")
}

/// Ten single-use recovery codes, stored as SHA-256 hashes, shown once.
model MfaRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("mfa_recovery_codes")
}

/// "The first step passed, a code is still owed": bound to one account, short-lived, single use, burnt after 5 wrong codes.
/// The raw token lives only in an httpOnly cookie; the id is its SHA-256.
model AuthTicket {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// verify (has an authenticator) | enroll (sets one up now)
  stage     String
  /// How the first step was passed (password, google, github, ...), the sealed new seed during enrolment, the guest cart.
  data      Json
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("auth_tickets")
}

/// "Trust this device for 30 days": skips the code on this browser for this account. Ended by a password change or reset,
/// an MFA reset, "Forget trusted devices", or signing out everywhere.
model TrustedDevice {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
  @@map("trusted_devices")
}

/// Password reset links: SHA-256 at rest, one hour, single use; a new link burns the old ones.
model PasswordReset {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_resets")
}

/// One paid year of access to a course (owner 2026-11-25). Renewing early adds a year after the current end; refunding
/// a renewal revokes only that year. Enrollment.accessExpiresAt is the latest end of the periods still in force.
model AccessPeriod {
  id          String    @id @default(uuid())
  userId      String
  courseId    String
  orderLineId String?   @unique
  /// Manual enrollment course line that granted this period (instead of an order line).
  manualItemId String?  @unique
  startsAt    DateTime
  endsAt      DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, courseId])
  @@map("access_periods")
}

/// Contact page (owner 2026-11-25): a message to DEL support, optionally with screenshots. Emailed to CONTACT_EMAIL.
model ContactMessage {
  id          String    @id @default(uuid())
  /// Short reference shown to the sender (C-1001).
  number      Int       @unique @default(autoincrement())
  name        String
  email       String
  topic       String
  subject     String
  body        String
  userId      String?
  /// [{ key, name, mime, sizeBytes }] in private storage (contact/<id>/...).
  attachments Json      @default("[]")
  status      String    @default("new") // new | handled
  handledById String?
  handledAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
  @@map("contact_messages")
}

/// Complete course package: course-level downloads (all demo code, configs, docs) next to the per-lesson files.
model CourseResource {
  id         String   @id @default(uuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title      String
  storageKey String
  sizeBytes  Int
  mime       String
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([courseId, position])
  @@map("course_resources")
}

/// Manual enrollment (owner 2026-11-25, docs/MANUAL_ENROLLMENT.md): a student gets one or more courses after an
/// external payment (bank transfer, mobile money...) or as a complimentary grant. Instructors request it for their own
/// courses; only a super admin approves, verifies the payment and activates access. Never charges or pays via Stripe.
model ManualEnrollment {
  id               String   @id @default(uuid())
  number           Int      @unique @default(autoincrement())
  /// pending | needs_info | approved | rejected | cancelled
  status           String   @default("pending")
  studentEmail     String
  studentName      String
  /// Set when the email belongs to an existing account (or once the invitation is accepted).
  studentId        String?
  requestedById    String
  /// instructor | super_admin (a super admin's direct enrollment needs no second approval)
  requestedByRole  String
  note             String   @default("")
  reviewNote       String?
  complimentary    Boolean  @default(false)
  complimentaryReason String?
  decidedById      String?
  decidedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  items            ManualEnrollmentItem[]
  payments         ExternalPayment[]
  invitations      Invitation[]

  @@index([status])
  @@index([requestedById])
  @@index([studentEmail])
  @@map("manual_enrollments")
}

model ManualEnrollmentItem {
  id            String    @id @default(uuid())
  requestId     String
  request       ManualEnrollment @relation(fields: [requestId], references: [id], onDelete: Cascade)
  courseId      String
  /// Course owner when requested (revenue is attributed to them).
  instructorId  String
  listPriceCents Int
  expiresAt     DateTime
  activatedAt   DateTime?
  revokedAt     DateTime?
  allocations   ExternalPaymentAllocation[]

  @@unique([requestId, courseId])
  @@index([courseId])
  @@map("manual_enrollment_items")
}

/// An external payment as recorded and verified by a super admin. Amounts in minor units of `currency`; USD for reports.
model ExternalPayment {
  id            String    @id @default(uuid())
  requestId     String
  request       ManualEnrollment @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// bank_transfer | mobile_money | cash | paypal | other
  method        String
  reference     String
  currency      String
  amountMinor   Int
  /// USD per 1 unit of `currency` (documented rate; 1 for USD).
  usdRate       String
  grossUsdCents Int
  feeUsdCents   Int
  netUsdCents   Int
  /// pending | verified
  status        String    @default("pending")
  notes         String    @default("")
  recordedById  String
  verifiedById  String?
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  allocations   ExternalPaymentAllocation[]

  @@unique([method, reference])
  @@map("external_payments")
}

/// One payment's share for one course: what the instructor earned and whether it was paid out (by hand, never Stripe).
model ExternalPaymentAllocation {
  id              String   @id @default(uuid())
  paymentId       String
  payment         ExternalPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  itemId          String
  item            ManualEnrollmentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  instructorId    String
  grossUsdCents   Int
  feeUsdCents     Int
  netUsdCents     Int
  instructorCents Int
  platformCents   Int
  /// earnings_recorded | payout_pending | payout_completed
  payoutStatus    String   @default("earnings_recorded")
  payoutReference String?
  payoutAt        DateTime?
  payoutById      String?

  @@unique([paymentId, itemId])
  @@index([instructorId])
  @@map("external_payment_allocations")
}

/// Invitation to create a student account for a manual enrollment. Only a hash of the token is stored; a new link
/// invalidates the previous one. Opening the link proves nothing by itself: the student confirms the email address.
model Invitation {
  id          String    @id @default(uuid())
  tokenHash   String    @unique
  requestId   String
  request     ManualEnrollment @relation(fields: [requestId], references: [id], onDelete: Cascade)
  email       String
  /// pending | accepted | expired | revoked
  status      String    @default("pending")
  expiresAt   DateTime
  createdById String
  acceptedAt  DateTime?
  acceptedUserId String?
  revokedAt   DateTime?
  /// Six-digit email code for the ownership check (hashed), with its expiry and tries.
  codeHash    String?
  codeExpiresAt DateTime?
  codeTries   Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([requestId])
  @@map("invitations")
}

/// An instructor flags a review on their own course (spam, abuse, fake, …); a super admin investigates (owner 2026-11-25).
/// Instructors never delete reviews; low ratings alone are not a reason to remove one.
model ReviewReport {
  id           String    @id @default(uuid())
  reviewId     String
  reporterId   String
  /// spam | abusive | fake | off_topic | personal_data | other
  reason       String
  details      String    @default("")
  /// open | dismissed | actioned
  status       String    @default("open")
  resolvedById String?
  resolvedAt   DateTime?
  resolution   String?
  createdAt    DateTime  @default(now())

  @@index([status])
  @@index([reviewId])
  @@map("review_reports")
}

// ---------------- career paths (owner 2026-11-26, idea 4; docs/CAREER_PATHS.md) ----------------

/// A goal such as "DevOps engineer": an ordered list of marketplace courses with the skills each gives. Super admins
/// write them; only published paths are public. A path never sells anything itself: each course is bought on its own.
model CareerPath {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  /// One or two sentences for cards and search results.
  summary     String    @default("")
  /// Longer text for the path page (Markdown).
  description String    @default("")
  /// draft | published
  status      String    @default("draft")
  publishedAt DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  steps     CareerPathStep[]
  followers CareerPathFollow[]

  @@index([status])
  @@map("career_paths")
}

model CareerPathStep {
  id       String     @id @default(uuid())
  pathId   String
  path     CareerPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  courseId String
  course   Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  position Int
  /// Short skill names this course gives, e.g. "Docker", "Kubernetes basics".
  skills   String[]   @default([])
  note     String     @default("")

  @@unique([pathId, courseId])
  @@index([pathId, position])
  @@map("career_path_steps")
}

/// A student following a path, with the study time they plan per week (for the weekly plan and finish date).
model CareerPathFollow {
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  pathId       String
  path         CareerPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  hoursPerWeek Int        @default(5)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@id([userId, pathId])
  @@index([pathId])
  @@map("career_path_follows")
}
