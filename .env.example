# Copy to .env (never commit it). ./scripts/make-env.sh fills random secrets.
NODE_ENV=development
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://del:${POSTGRES_PASSWORD}@postgres:5432/marketplace
REDIS_URL=redis://redis:6379
SESSION_SECRET=
WEB_URL=http://127.0.0.1:3000
API_URL=http://127.0.0.1:4000
# Local object storage (MinIO) standing in for S3
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=del-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Video provider: local | mux
VIDEO_PROVIDER=local
# Content protection (docs/CONTENT_PROTECTION.md): encrypted HLS for enrolled learners; false = signed MP4 links
PROTECTED_PLAYBACK=true
HLS_SEGMENT_SECONDS=4
# true = re-encode to 2 s keyframes while packaging (faster start, more CPU)
HLS_REENCODE=false
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
MUX_WEBHOOK_SECRET=
# Stripe (test mode). Empty = use DEV_TEST_PAYMENTS locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
DEV_TEST_PAYMENTS=true
# Seed accounts' password (local only)
SEED_PASSWORD=
# Local demo accounts' Google Authenticator seed (base32). make-env.sh fills it; add it to your authenticator app to sign in
# as a demo account. Never used in production.
SEED_MFA_SECRET=
# Login/register attempts per minute per IP
AUTH_RATE_LIMIT=20

# --- Sign-in (docs/AUTH.md) ---------------------------------------------------------------------------------------------
# Each provider's button appears only when both values are set. Callback URL to register with the provider:
#   <API_URL>/api/auth/oauth/<google|github|facebook|linkedin>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Development only: false skips the Google Authenticator step locally (always required in production).
MFA_REQUIRED=true
# Development only: a "Test provider" button to try social sign-in without real keys (refused in production).
OAUTH_TEST_PROVIDER=false
# Check new passwords against Have I Been Pwned (only 5 characters of a hash leave the server).
PASSWORD_BREACH_CHECK=true
# Optional: AI summaries of refund requests for admins (Claude). Leave empty to hide them.
ANTHROPIC_API_KEY=
REFUND_AI_MODEL=claude-opus-5-5
# AI learning (docs/AI_LEARNING.md): course assistant + study notes need the key above; video search does not.
LEARNING_AI_MODEL=claude-opus-5-5
# Optional cheaper model for the high-volume "Ask about this course" answers (empty = LEARNING_AI_MODEL).
LEARNING_AI_ASK_MODEL=
LEARNING_AI_ENABLED=true
LEARNING_AI_PER_MINUTE=5
LEARNING_AI_PER_DAY=30
LEARNING_AI_PLATFORM_PER_DAY=500

# ---- Email (docs/EMAIL.md) ----
# Local: smtp → the Mailpit container (open http://127.0.0.1:8025 to read every email). Production: resend.
EMAIL_PROVIDER=smtp
SMTP_URL=smtp://mailpit:1025
EMAIL_FROM=DevOps Easy Learning <no-reply@devopseasylearning.com>
EMAIL_REPLY_TO=support@devopseasylearning.com
# Production only, from the Resend dashboard (never commit it):
RESEND_API_KEY=
# Contact page messages go here:
CONTACT_EMAIL=support@devopseasylearning.com
